# KennaBot Configuration
# Copy this file to .env and fill in the values.

# =============================================================================
# Required: Slack Tokens
# =============================================================================

# Bot User OAuth Token — found at:
# https://api.slack.com/apps/<YOUR_APP_ID>/oauth
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# App-Level Token (for Socket Mode) — generate at:
# https://api.slack.com/apps/<YOUR_APP_ID>/general
# Requires the "connections:write" scope.
SLACK_APP_TOKEN=xapp-your-app-token-here

# =============================================================================
# Optional: KennaBot Settings (all use the KENNABOT_ prefix)
# =============================================================================

# Path to the SQLite database file (default: ./data/kennabot.db)
# KENNABOT_DB_PATH=./data/kennabot.db

# Comma-separated list of Slack user IDs who can use /plusplus erase
# If empty, anyone can erase (not recommended for production).
# KENNABOT_ADMIN_USERS=U0123ADMIN,U0456ADMIN

# Cooldown in seconds between votes from the same user to the same target (default: 5)
# KENNABOT_COOLDOWN_SECONDS=5

# Comma-separated conjunction words for reasons (default: for,because,cause,cuz,as)
# KENNABOT_REASON_CONJUNCTIONS=for,because,cause,cuz,as

# Logging level: DEBUG, INFO, WARNING, ERROR (default: INFO)
# KENNABOT_LOG_LEVEL=INFO
